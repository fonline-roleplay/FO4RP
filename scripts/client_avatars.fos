#ifndef CLIENT_AVATARS
#define CLIENT_AVATARS

#include "_utils.fos"
#include "sprite.fos"

enum EAvatarPlaceholder
{
	AvatarStateNone,
	AvatarStateNoFound,
	AvatarStateDownload,
	AvatarPlayer,
	AvatarStateGood
}

enum EAvatarRenderMode
{
    AvatarRenderModeBegin,
    AvatarRenderModeAll = AvatarRenderModeBegin,
    AvatarRenderModeOnlyMouse,
    AvatarRenderModeNo,
    AvatarRenderModeCount
}

AvatarRenderer@[] AvatarRenderers = 
{
	AvatarRendererAll(),
	AvatarRendererOnlyMouse()
};

dictionary AvatarLib;
const Sprite@[]@ AvatarPlaceholders = null;
const uint AvatarSize = 64;

class Avatar : Sprite
{
	EAvatarPlaceholder State;
	string ManagedName;
	bool SyncPending;
	
	Avatar( string& name )
	{
		ManagedName = name;
		bool localLoaded = Load("ManagedFiles/" + ManagedName, PT_DATA);
		SyncPending = RequestManagedFile(ManagedName);
		if (localLoaded)
			State = EAvatarPlaceholder::AvatarStateGood;
		else
			State = SyncPending ? EAvatarPlaceholder::AvatarStateDownload : EAvatarPlaceholder::AvatarStateNoFound;
	}	

	void RefreshManaged()
	{
		if (!SyncPending)
			return;
		int state = GetManagedFileState(ManagedName);
		if (state == 2)
		{
			SyncPending = false;
			State = Load("ManagedFiles/" + ManagedName, PT_DATA) ? EAvatarPlaceholder::AvatarStateGood : EAvatarPlaceholder::AvatarStateNoFound;
		}
		else if (state < 0)
		{
			SyncPending = false;
			if (State != EAvatarPlaceholder::AvatarStateGood)
				State = EAvatarPlaceholder::AvatarStateNoFound;
		}
	}
}

string GetManagedAvatarName(uint critterId, uint index, int avatarKey)
{
	uint key = uint(avatarKey);
	uint extension = key >> 30;
	if (extension > 1)
		return "";
	string ext = extension == 1 ? "jpg" : "png";
	return "avatar-" + critterId + "-" + index + "-" + (key & 0x3FFFFFFF) + "." + ext;
}

Avatar@ LoadAvatar( string& name )
{
	Avatar@ result = Avatar( name );
	AvatarLib.set( name, @result );
	return result;
}

Sprite@ GetAvatar( CritterCl& critter )
{
	return GetAvatar(critter, uint(critter.Param[ST_AVATAR_INDEX]));
}

Sprite@ GetAvatar(CritterCl& critter, uint index)
{
	int avatarKey = critter.Avatar[AVATAR_BEGIN + index];
	if (avatarKey == 0)
		return AvatarPlaceholders[critter.IsPlayer() ? EAvatarPlaceholder::AvatarPlayer : EAvatarPlaceholder::AvatarStateNone];
	
	string name = GetManagedAvatarName(critter.Id, index, avatarKey);
	if (name.length() == 0)
		return AvatarPlaceholders[EAvatarPlaceholder::AvatarStateNoFound];
	
	Avatar@ result = null;
	if (!AvatarLib.get(name, @result))
		@result = LoadAvatar(name);
	
	if (!valid(result))
		return AvatarPlaceholders[EAvatarPlaceholder::AvatarStateNone];
	
	result.RefreshManaged();
	if (result.State == EAvatarPlaceholder::AvatarStateGood)
		return result;
	return AvatarPlaceholders[result.State];
}

class AvatarRenderer
{
	void Render( Sprite@ avatar, CritterCl& critter, int x, int y, int w, int h, uint alpha )
	{
		
	}
	
	bool IsCollision( int x1, int y1, int x2, int y2, int w, int h )
	{
		return ( ( x1 ) >= ( x2 ) && ( x1 ) <= ( x2 ) + ( w ) && ( y1 ) >= ( y2 ) && ( y1 ) <= ( y2 ) + ( h ) );
	}
}

class AvatarRendererAll : AvatarRenderer
{
	void Render( Sprite@ avatar, CritterCl& critter, int x, int y, int w, int h, uint alpha ) override
	{
		y = h;		
		x += int( ( w - x ) * 0.5 );
		int size = int(AvatarSize);
		x -= int(size/2);
		y -= size + 20;
		if( !IsCollision( __MouseX, __MouseY, x, y, size, size) )
		{
			DrawSprite( avatar.Id, 0, x, y, size, size, true, false, 0 );
			DrawRectangle( x, y, x + size, y + size, int( COLOR_BLACK ) );
		}
	}
}

class AvatarRendererOnlyMouse : AvatarRenderer
{
	void Render( Sprite@ avatar, CritterCl& critter, int x, int y, int w, int h, uint alpha ) override
	{
		int size = int(AvatarSize);
		DrawSprite( avatar.Id, 0, __ScreenWidth - size, 0, size, size, true, false, 0 );
		DrawRectangle( __ScreenWidth - size, 0, __ScreenWidth, size, int( COLOR_BLACK ) );
	}
}

void AvatarRender( CritterCl& critter, int x, int y, int w, int h, uint alpha )
{
	if( ABS( critter.Param[ QST_MEDIUM ] ) == 2 )
	{
		return;
	}
	
	int avatarMode = GetChosen().Param[ CR_AVATAR_RENDER_MODE ];
    if( avatarMode < EAvatarRenderMode::AvatarRenderModeBegin || avatarMode >= EAvatarRenderMode::AvatarRenderModeCount )
    {
        return;
    }
	
	auto avatar = GetAvatar( critter );
	if( !valid( avatar ) || avatar.Id == 0 )
	{
		return;
	}

	AvatarRenderers[avatarMode].Render( avatar, critter, x, y, w, h, alpha );
}

void AvatarRenderCritter(CritterCl& critter)
{
	bool nameVisible = false;
	int x = 0;
	int y = 0;
	int width = 0;
	int height = 0;
	int lines = 0;
	critter.GetNameTextInfo(nameVisible, x, y, width, height, lines);
	CritterCl@ chosen = GetChosen();
	if (valid(chosen) && chosen.Param[CR_AVATAR_RENDER_MODE] == EAvatarRenderMode::AvatarRenderModeAll &&
		!nameVisible && width > 0 && height > 0)
		return;
	if (width > 0 && height > 0)
		AvatarRender(critter, x, y, x + width, y + height, 0xFF);
	else
		AvatarRender(critter, x - 100, y - 70, x + 100, y, 0xFF);
}

void AvatarRenderIface()
{
	if (__GmapActive)
		return;
	CritterCl@ chosen = GetChosen();
	if (!valid(chosen))
		return;
	int avatarMode = chosen.Param[CR_AVATAR_RENDER_MODE];
	if (avatarMode == EAvatarRenderMode::AvatarRenderModeNo)
		return;
	if (avatarMode == EAvatarRenderMode::AvatarRenderModeOnlyMouse)
	{
		CritterCl@ hovered = MouseCritter;
		if (valid(hovered))
			AvatarRenderCritter(hovered);
		return;
	}
	if (avatarMode != EAvatarRenderMode::AvatarRenderModeAll)
		return;

	CritterCl@[] critters;
	GetCritters(0, FIND_ALL, critters);
	bool chosenFound = false;
	for (uint i = 0; i < critters.length(); i++)
		if (valid(chosen) && valid(critters[i]) && critters[i].Id == chosen.Id)
			chosenFound = true;
	if (valid(chosen) && !chosenFound)
		critters.insertLast(chosen);

	for (uint i = 0; i < critters.length(); i++)
	{
		CritterCl@ critter = critters[i];
		if (!valid(critter))
			continue;
		AvatarRenderCritter(critter);
	}
}

void SetAvatarPlaceholders( const array<Sprite@>@ placeholders )
{
	@AvatarPlaceholders = placeholders;
}

void DrawRectangle( int x, int y, int w, int h, int color )
{
	int[] data = {
		x, y, color,
		x, h, color,
		w, h, color,
		w, y, color,
		x, y, color
	};
	
	DrawPrimitive( DRAW_PRIMITIVE_LINESTRIP, data );
}

# endif // CLIENT_AVATARS
