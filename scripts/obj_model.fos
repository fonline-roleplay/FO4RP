#ifndef OBJ_MODEL
#define OBJ_MODEL

#include "_utils.fos"
#include "obj_model.fosh"
#include "fofmod_h.fos"

interface IWritable
{
    bool WriteToFile( file@ writeFile );
}

enum VertexVecType
{
    VERT_GEOM = 0,
    VERT_TEX,
    VERT_NORM,
    VERT_PARM
}

#define VERT_GEOM_X     ( 0 )
#define VERT_GEOM_Y     ( 1 )
#define VERT_GEOM_Z     ( 2 )
#define VERT_GEOM_W     ( 3 )

#define VERT_TEX_U      ( 0 )
#define VERT_TEX_V      ( 1 )
#define VERT_TEX_W      ( 2 )

#define VERT_NORM_I     ( 0 )
#define VERT_NORM_J     ( 1 )
#define VERT_NORM_K     ( 2 )

#define VERT_PARM_U     ( 0 )
#define VERT_PARM_V     ( 1 )
#define VERT_PARM_W     ( 2 )

class VertexVec : IWritable
{
    uint VertType = VERT_GEOM;
    double[] VertData = {0.0, 0.0, 0.0, 0.0};

    VertexVec(uint type)
    {
        VertType = type;
    }

    double get_opIndex(int idx) const
    {
        return VertData[idx];
    }
    void set_opIndex(int idx, double value)
    {
        VertData[idx] = value;
    }

    bool WriteToFile( file@ writeFile )
    {
        if(!valid(writeFile)) return false;

        string strToWrite = "";
        
        switch(VertType)
        {
        case VERT_GEOM:
        {
            strToWrite += "v\t\t";
            strToWrite += "" + VertData[0] + (VertData[0] > 0.0 ? "\t\t\t" : "\t\t");
            strToWrite += "" + VertData[1] + (VertData[1] > 0.0 ? "\t\t\t" : "\t\t");
            strToWrite += "" + VertData[2];
            strToWrite += "\n";
        }
        break;
        case VERT_TEX:
        {
            strToWrite += "vt\t\t";
            strToWrite += "" + VertData[0] + (VertData[0] > 0.0 ? "\t\t\t" : "\t\t");
            strToWrite += "" + VertData[1] + (VertData[1] > 0.0 ? "\t\t\t" : "\t\t");
            strToWrite += "" + VertData[2];
            strToWrite += "\n";
        }
        break;
        case VERT_NORM:
        {
            strToWrite += "vn\t\t";
            strToWrite += "" + VertData[0] + (VertData[0] > 0.0 ? "\t\t\t" : "\t\t");
            strToWrite += "" + VertData[1] + (VertData[1] > 0.0 ? "\t\t\t" : "\t\t");
            strToWrite += "" + VertData[2];
            strToWrite += "\n";
        }
        break;
        case VERT_PARM:
        {
            strToWrite += "vp\t\t";
            strToWrite += "" + VertData[0] + (VertData[0] > 0.0 ? "\t\t\t" : "\t\t");
            strToWrite += "" + VertData[1];
            strToWrite += "\n";
        }
        break;
        }

        writeFile.writeString(strToWrite);

        return true;
    }
}

class Primitive : IWritable
{
    uint PrimType = PRIM_POINT;
    int[] PrimData = {};

    Primitive(uint type)
    {
        PrimType = type;
    }

    int get_opIndex(int idx) const
    {
        return PrimData[idx];
    }
    void set_opIndex(int idx, int value)
    {
        PrimData[idx] = value;
    }

    void insertLast(int value)
    {
        PrimData.insertLast(value);
    }

    bool WriteToFile( file@ writeFile )
    {
        if(!valid(writeFile)) return false;

        string strToWrite = "";
        
        switch(PrimType)
        {
        case PRIM_POINT:
        {
            strToWrite += "p\t\t";
        }
        break;
        case PRIM_LINE:
        {
            strToWrite += "l\t\t";
        }
        break;
        case PRIM_FACE:
        {
            strToWrite += "f\t\t";
        }
        break;
        }

        for(uint i = 0, len = PrimData.length(); i < len; i++)
        {
            strToWrite += " " + PrimData[i];
        }
        strToWrite += "\n";

        writeFile.writeString(strToWrite);

        return true;
    }
}

class OBJModel : IOBJModel
{
    string MatName = "Default";
    VertexVec@[] VertGeomArray;
    VertexVec@[] VertTexArray;
    VertexVec@[] VertNormArray;
    VertexVec@[] VertParmArray;
    Primitive@[] PrimPointArray;
    Primitive@[] PrimLineArray;
    Primitive@[] PrimFaceArray;

    void SetMatName(string& name)
    {
        if(!valid(name)) return;
        MatName = name;
    }

    string& GetMatName()
    {
        return MatName;
    }

    void AddTypedVertex(VertexVec@ vert, uint vertType)
    {
        switch(vertType)
        {
        case VERT_GEOM:
            VertGeomArray.insertLast(vert);
            break;
        case VERT_TEX:
            VertTexArray.insertLast(vert);
            break;
        case VERT_NORM:
            VertNormArray.insertLast(vert);
            break;
        case VERT_PARM:
            VertParmArray.insertLast(vert);
            break;
        }
    }

    void AddGeomVertex(VertexVec@ vert)
    {
        AddTypedVertex(vert, VERT_GEOM);
    }

    void AddGeomVertex(double x, double y, double z)
    {
        VertexVec@ vert = VertexVec(VERT_GEOM);
        vert[VERT_GEOM_X] = x;
        vert[VERT_GEOM_Y] = y;
        vert[VERT_GEOM_Z] = z;
        AddGeomVertex(vert);
    }

    void AddTexVertex(VertexVec@ vert)
    {
        AddTypedVertex(vert, VERT_TEX);
    }

    void AddTexVertex(double u, double v, double w)
    {
        VertexVec@ vert = VertexVec(VERT_TEX);
        vert[VERT_TEX_U] = u;
        vert[VERT_TEX_V] = v;
        vert[VERT_TEX_W] = w;
        AddTexVertex(vert);
    }

    void AddNormVertex(VertexVec@ vert)
    {
        AddTypedVertex(vert, VERT_NORM);
    }

    void AddNormVertex(double i, double j, double k)
    {
        VertexVec@ vert = VertexVec(VERT_NORM);
        vert[VERT_NORM_I] = i;
        vert[VERT_NORM_J] = j;
        vert[VERT_NORM_K] = k;
        AddNormVertex(vert);
    }

    void AddParmVertex(VertexVec@ vert)
    {
        AddTypedVertex(vert, VERT_PARM);
    }

    void AddParmVertex(double u, double v)
    {
        VertexVec@ vert = VertexVec(VERT_PARM);
        vert[VERT_PARM_U] = u;
        vert[VERT_PARM_V] = v;
        AddParmVertex(vert);
    }
    
    void AddTypedPrimitive(Primitive@ prim, uint primType)
    {
        switch(primType)
        {
        case PRIM_POINT:
            PrimPointArray.insertLast(prim);
            break;
        case PRIM_LINE:
            PrimLineArray.insertLast(prim);
            break;
        case PRIM_FACE:
            PrimFaceArray.insertLast(prim);
            break;
        }
    }

    void AddTypedPrimitive(int[] primitiveData, uint primType)
    {
        Primitive@ prim = Primitive(primType);
        for(uint i = 0, len = primitiveData.length(); i < len; i++)
        {
            prim.insertLast(primitiveData[i]);
        }

        AddTypedPrimitive(prim, primType);
    }
    
    void WriteToFile(file@ writeFile)
    {
        if(!valid(writeFile)) return;

        writeFile.writeString("o base\n");
        writeFile.writeString("\n# Vertex List\n\n");
        for(uint i = 0, len = VertGeomArray.length(); i < len; i++)
        {
            IWritable@ currVert = VertGeomArray[i];
            if(!valid(currVert)) continue;
            currVert.WriteToFile(writeFile);
        }
        writeFile.writeString("\n# Point/Line/Face List\n");
        writeFile.writeString("usemtl " + MatName);
        
        if(PrimPointArray.length() > 0)
        {
            writeFile.writeString("\n");
            for(uint i = 0, len = PrimPointArray.length(); i < len; i++)
            {
                IWritable@ currPrim = PrimPointArray[i];
                if(!valid(currPrim)) continue;
                currPrim.WriteToFile(writeFile);
            }
        }
        if(PrimLineArray.length() > 0)
        {
            writeFile.writeString("\n");
            for(uint i = 0, len = PrimLineArray.length(); i < len; i++)
            {
                IWritable@ currPrim = PrimLineArray[i];
                if(!valid(currPrim)) continue;
                currPrim.WriteToFile(writeFile);
            }
        }
        if(PrimFaceArray.length() > 0)
        {
            writeFile.writeString("\n");
            for(uint i = 0, len = PrimFaceArray.length(); i < len; i++)
            {
                IWritable@ currPrim = PrimFaceArray[i];
                if(!valid(currPrim)) continue;
                currPrim.WriteToFile(writeFile);
            }
        }
    }
}

IOBJModel@ OBJModelFactory()
{
    IOBJModel@ newModel = OBJModel();
    return newModel;
}

double[] LatestModelVertices;
int[] LatestModelAudioPolygons;
double[] LatestModelAudioOcclusions;
uint16[] LatestModelAudioHexes;
uint16 LatestModelMapPid = 0;
uint SoundBlockHexSpriteId = 0;
bool SoundMeshDebugVisible = false;

void CacheModelVertex(double x, double y, double z)
{
    LatestModelVertices.insertLast(x);
    LatestModelVertices.insertLast(y);
    LatestModelVertices.insertLast(z);
}

void CacheAudioQuad(int a, int b, int c, int d, double occlusion)
{
    LatestModelAudioPolygons.insertLast(4);
    LatestModelAudioPolygons.insertLast(a);
    LatestModelAudioPolygons.insertLast(b);
    LatestModelAudioPolygons.insertLast(c);
    LatestModelAudioPolygons.insertLast(d);
    LatestModelAudioOcclusions.insertLast(occlusion);
}

uint8 GetProtoHearBlockDir(const ProtoItem@ proto, uint dir)
{
    if(!valid(proto)) return 100;
    switch(dir)
    {
    case 0: return proto.Hear_BlockDir_0;
    case 1: return proto.Hear_BlockDir_1;
    case 2: return proto.Hear_BlockDir_2;
    case 3: return proto.Hear_BlockDir_3;
    case 4: return proto.Hear_BlockDir_4;
    case 5: return proto.Hear_BlockDir_5;
    }
    return 100;
}

// Add a closed flat-top hexagonal prism centered on a solid map hex.
// Audio-space adjacent hex centers are one unit apart. A flat-top hex with
// radius 1/sqrt(3) therefore meets its neighbors without leaving gaps.
int AddSolidHexMesh(IOBJModel@ obj, double centerX, double centerY, int firstVertexIndex,
    const double[]& faceOcclusion)
{
    if(!valid(obj)) return firstVertexIndex;

    const double radius = 0.5773502691896258;
    const double height = 3.0;
    const double halfSqrt3 = 0.8660254037844386;

    const double[] cornerX = {
         0.5, -0.5, -1.0,
        -0.5,  0.5,  1.0
    };
    const double[] cornerZ = {
         halfSqrt3,  halfSqrt3, 0.0,
        -halfSqrt3, -halfSqrt3, 0.0
    };

    // Bottom ring, followed by the top ring.
    for(uint i = 0; i < 6; i++)
    {
        obj.AddGeomVertex(centerX + cornerX[i] * radius, centerY + cornerZ[i] * radius, 0.0);
        CacheModelVertex(centerX + cornerX[i] * radius, centerY + cornerZ[i] * radius, 0.0);
    }
    for(uint i = 0; i < 6; i++)
    {
        obj.AddGeomVertex(centerX + cornerX[i] * radius, centerY + cornerZ[i] * radius, height);
        CacheModelVertex(centerX + cornerX[i] * radius, centerY + cornerZ[i] * radius, height);
    }

    int cachedFirstVertex = firstVertexIndex - 1;
    for(int i = 0; i < 6; i++)
    {
        int next = (i + 1) % 6;
        CacheAudioQuad(cachedFirstVertex + i, cachedFirstVertex + next,
            cachedFirstVertex + 6 + next, cachedFirstVertex + 6 + i,
            i < int(faceOcclusion.length()) ? faceOcclusion[i] : 1.0);
    }

    // Caps. OBJ indices are one-based.
    obj.AddTypedPrimitive(array<int> = {
        firstVertexIndex + 5, firstVertexIndex + 4, firstVertexIndex + 3,
        firstVertexIndex + 2, firstVertexIndex + 1, firstVertexIndex
    }, PRIM_FACE);
    obj.AddTypedPrimitive(array<int> = {
        firstVertexIndex + 6, firstVertexIndex + 7, firstVertexIndex + 8,
        firstVertexIndex + 9, firstVertexIndex + 10, firstVertexIndex + 11
    }, PRIM_FACE);

    // Six vertical sides.
    for(int i = 0; i < 6; i++)
    {
        int next = (i + 1) % 6;
        obj.AddTypedPrimitive(array<int> = {
            firstVertexIndex + i,
            firstVertexIndex + next,
            firstVertexIndex + 6 + next,
            firstVertexIndex + 6 + i
        }, PRIM_FACE);
    }

    return firstVertexIndex + 12;
}

void GenerateMapModel()
{
    LatestModelVertices.resize(0);
    LatestModelAudioPolygons.resize(0);
    LatestModelAudioOcclusions.resize(0);
    LatestModelAudioHexes.resize(0);
    LatestModelMapPid = GetCurrentMapPid();

    IOBJModel@ obj = OBJModelFactory();
    uint hexMapWidth = GetMapWidth();
    uint hexMapHeight = GetMapHeight();

    // Exact bounds of the aligned odd-column grid. Odd columns extend half a
    // hex above even columns, which isn't necessarily represented by a map
    // corner when the final column is even.
    float lastColumnX = 0.0f;
    float unusedY = 0.0f;
    CoordinatesHexToAudio(int(hexMapWidth) - 1, 0, lastColumnX, unusedY);
    double minX = 0.0;
    double maxX = double(lastColumnX);
    double minY = hexMapWidth > 1 ? -0.5 : 0.0;
    double maxY = double(hexMapHeight) - 1.0;

    const double hexHalfWidth = 0.5773502691896258;
    const double hexHalfHeight = 0.5;
    minX -= hexHalfWidth;
    maxX += hexHalfWidth;
    minY -= hexHalfHeight;
    maxY += hexHalfHeight;

    obj.AddGeomVertex(minX, minY, 0.0);
    obj.AddGeomVertex(maxX, minY, 0.0);
    obj.AddGeomVertex(maxX, maxY, 0.0);
    obj.AddGeomVertex(minX, maxY, 0.0);
    CacheModelVertex(minX, minY, 0.0);
    CacheModelVertex(maxX, minY, 0.0);
    CacheModelVertex(maxX, maxY, 0.0);
    CacheModelVertex(minX, maxY, 0.0);
    obj.AddTypedPrimitive(array<int> = {1, 2, 3, 4}, PRIM_FACE);

    ItemCl@[] items;
    uint itemsLen = GetAllMapObjects(items);

    // The ground plane occupies OBJ vertices 1..4.
    int nextVertexIndex = 5;
    dictionary solidHexes;

    for(uint i = 0; i < itemsLen; i++)
    {
        ItemCl@ item = items[i];
        if(!valid(item)) continue;

        uint8 itemType = item.GetType();

        // ITEM_VIEW_BLOCKS belongs to the custom LookData attenuation system;
        // it isn't a generic "opaque wall" marker. Windows and wall openings
        // are shoot-through, while walls that should obstruct sound are not.
        bool isSolidWall = itemType == ITEM_TYPE_WALL && !FLAG(item.Flags, ITEM_SHOOT_THRU);
        bool isSpecialBlocker = item.Proto.ProtoId == 5621;
        bool isNonWallSoundBlocker = itemType != ITEM_TYPE_WALL && FLAG(item.Flags, ITEM_HEAR_BLOCK);
        if(!(isSolidWall || isSpecialBlocker || isNonWallSoundBlocker)) continue;

        // Multiple solid objects can occupy one hex; emit its geometry once.
        string hexKey = "" + item.HexX + ":" + item.HexY;
        if(solidHexes.exists(hexKey)) continue;
        solidHexes.set(hexKey, true);
        LatestModelAudioHexes.insertLast(item.HexX);
        LatestModelAudioHexes.insertLast(item.HexY);

        float x, y;
        CoordinatesHexToAudio(item.HexX, item.HexY, x, y);

        // Face order is north, north-west, south-west, south,
        // south-east, north-east. LookData indexes the direction from
        // listener to blocker, which is opposite the outward face.
        const uint[] incomingDir = {5, 4, 3, 2, 1, 0};
        double[] faceOcclusion(6);
        for(uint face = 0; face < 6; face++)
        {
            double permeability = 1.0;
            if(isSolidWall || isSpecialBlocker)
                permeability *= double(WallMaterialHearMultiplier[item.Proto.Material]) / 100.0;
            if(FLAG(item.Flags, ITEM_HEAR_BLOCK))
                permeability *= double(GetProtoHearBlockDir(item.Proto, incomingDir[face])) / 100.0;

            if(permeability < 0.0) permeability = 0.0;
            if(permeability > 1.0) permeability = 1.0;
            faceOcclusion[face] = 1.0 - permeability;
        }

        nextVertexIndex = AddSolidHexMesh(obj, double(x), double(y), nextVertexIndex, faceOcclusion);
    }

}

bool UpdateCurrentFModMesh()
{
    return FOFMOD_ReplaceGeometry(LatestModelVertices, LatestModelAudioPolygons, LatestModelAudioOcclusions);
}

bool RegenerateCurrentFModMesh()
{
    if(GetMapWidth() == 0 || GetMapHeight() == 0) return false;
    GenerateMapModel();
    return UpdateCurrentFModMesh();
}

void ClearCurrentFModMesh()
{
    LatestModelVertices.resize(0);
    LatestModelAudioPolygons.resize(0);
    LatestModelAudioOcclusions.resize(0);
    LatestModelAudioHexes.resize(0);
    LatestModelMapPid = 0;
    UpdateCurrentFModMesh();
}

void SetSoundMeshDebugVisible(bool visible)
{
    SoundMeshDebugVisible = visible;
}

void RenderLatestSoundBlockingHexes()
{
    if(!SoundMeshDebugVisible) return;
    if(LatestModelAudioHexes.length() == 0) return;
    if(LatestModelMapPid != GetCurrentMapPid()) return;
    if(SoundBlockHexSpriteId == 0)
        SoundBlockHexSpriteId = LoadSprite("exit_new.frm", int(PT_ART_SCENERY));
    if(SoundBlockHexSpriteId == 0) return;

    int spriteWidth = GetSpriteWidth(SoundBlockHexSpriteId, 0);
    int spriteHeight = GetSpriteHeight(SoundBlockHexSpriteId, 0);
    int drawWidth = int(float(spriteWidth) / __SpritesZoom);
    int drawHeight = int(float(spriteHeight) / __SpritesZoom);
    const uint markerColor = COLOR_RGBA(190, 32, 255, 190);

    for(uint i = 0; i + 1 < LatestModelAudioHexes.length(); i += 2)
    {
        int screenX = 0, screenY = 0;
        if(!GetHexPos(LatestModelAudioHexes[i], LatestModelAudioHexes[i + 1], screenX, screenY)) continue;

        DrawSprite(SoundBlockHexSpriteId, -1,
            screenX - drawWidth / 2, screenY - drawHeight / 2,
            drawWidth, drawHeight, true, false, markerColor);
    }
}

#endif // OBJ_MODEL
