// Sets hit location when pressed
class VATSPicker: IGUIElementCallbackInit, IGUIElementCallbackMouseClick
{
    IGUIElementOpt@ Options;
    int LimbIndex = -1;

    VATSPicker(int limbInd)
    {
        LimbIndex = limbInd;
    }

    void OnInit()
    {
        @Options = GUI_GetElementOptions();
    }

    void OnMouseClick( int click )
    {
        if( click != MOUSE_CLICK_LEFT ) return;
        if( LimbIndex < HIT_LOCATION_NONE || LimbIndex >= HIT_LOCATION_UNCALLED)
        {
            Message("ERROR: WRONG HIT_LOCATION SPECIFIED! CHECK SCRIPT!");
            return;
        }

        if(!valid(Options)) return;

        int realLimbIndex = Options.JammingState ? HIT_LOCATION_NONE : LimbIndex; // In order to make player able to disable precise hit - APAMk2
        RunServerScriptUnsafe( "main@unsafe_set_aim", realLimbIndex, 0, 0, null, null );
    }

    void SetState(bool isOn)
    {
        if(!valid(Options)) return;
        Options.JammingState = isOn;
    }
}

VATSPicker@[] VATSLimbPickers;

class VATSDisplay: IGUIElementCallbackInit
{
    IGUIElementOpt@ Options;
    int LimbIndex = -1;

    VATSDisplay(int limbInd)
    {
        LimbIndex = limbInd;
    }

    void OnInit()
    {
        @Options = GUI_GetElementOptions();
    }

    void SetState(bool isOn)
    {
        if(!valid(Options)) return;
        Options.JammingState = isOn;
    }
}

VATSDisplay@[] VATSLimbDisplays;

void UpdateVATSTarget()
{
    CritterCl@ chosen = GetChosen();
    if(!valid(chosen)) return;

    int currLimbIndex = chosen.Param[CR_AUTO_AIM];

    for(uint i = 0, len = VATSLimbPickers.length(); i < len; i++)
    {
        VATSPicker@ currPicker = VATSLimbPickers[i];
        if(!valid(currPicker)) continue;

        currPicker.SetState(currPicker.LimbIndex == currLimbIndex);
    }

    for(uint i = 0, len = VATSLimbDisplays.length(); i < len; i++)
    {
        VATSDisplay@ currDisplay = VATSLimbDisplays[i];
        if(!valid(currDisplay)) continue;

        currDisplay.SetState(currDisplay.LimbIndex == currLimbIndex);
    }
}

IEvent@ currTE;
CVATSUpdateEvent@ currVATSUpdateEvent = null;

class CVATSUpdateEvent : EventCallback
{	
	CVATSUpdateEvent()
	{
		if(valid(currTE))
		{
			currTE.Destroy();
		}
		@currTE = CreateTimeEvent(1000, this, null);
	}
	
    uint function(array<uint>@ variables)
    {
		UpdateVATSTarget();
        return 0;
    }	
}

// HACKHACK: We don't know params right after login, so we need to wait some time, before params packet will arrive - APAMk2
void UpdateVATSTargetDelayed()
{
    @currVATSUpdateEvent = CVATSUpdateEvent();
}

// VATS Precise Shot target ends here - APAMk2

void GUIInit()
{
    for(uint i = 0, len = HIT_LOCATION_UNCALLED - 1; i < len; i++)
    {
        VATSPicker currLimbPicker(i+1);
        CoordsXY@ currPickerCoords = VATSButtonCoords[i];
        if(!valid(currPickerCoords)) continue;

        GUI_AddScreenElement( CLIENT_MAIN_SCREEN_GAME, "", currPickerCoords.x, currPickerCoords.y )
            .CallbackInit( currLimbPicker )
            .CallbackMouseClick( currLimbPicker )
            .DownPic( VATSButtonName[i] )
            .SetSize( 21, 12 )
            .SetJamming(true);
        
        VATSLimbPickers.insertLast(@currLimbPicker);

        VATSDisplay currLimbDisplay(i+1);
        CoordsXY@ currDisplayCoords = VATSDisplayCoords[i];
        if(!valid(currDisplayCoords)) continue;
        CoordsXY@ currDisplaySize = VATSDisplaySize[i];
        if(!valid(currDisplaySize)) continue;

        GUI_AddScreenElement( CLIENT_MAIN_SCREEN_GAME, "", currDisplayCoords.x, currDisplayCoords.y )
            .CallbackInit( currLimbDisplay )
            .DownPic( VATSDisplayName[i] )
            .SetSize( currDisplaySize.x, currDisplaySize.y )
            .SetJamming(true);
        
        VATSLimbDisplays.insertLast(@currLimbDisplay);
    }
}

#endif // CLIENT_SCREEN_IFACE_MAIN
