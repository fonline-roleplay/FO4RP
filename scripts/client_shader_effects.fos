#ifndef CLIENT_SHADER_EFFECTS
#define CLIENT_SHADER_EFFECTS

#include "_utils.fos"
#include "client_shader_effects.fosh"

void SetGMInvis( Critter& cr, bool enable)
{
    if(!valid(cr)) return;

    if(enable)
		SetEffect(EFFECT_2D_CRITTER, cr.Id, "2D_Sneak.glsl");
	else 
		SetEffect(EFFECT_2D_CRITTER, cr.Id, null);
}

void ApplyShadersOnCritterIn( Critter& cr )
{
	if(!valid(cr)) return;
	SetGMInvis( cr, cr.Param[QST_INVIS] == 1);
}

#endif // CLIENT_SHADER_EFFECTS